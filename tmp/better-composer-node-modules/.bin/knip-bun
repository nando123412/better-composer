#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/bin/node_modules:/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/node_modules:/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules:/tmp/better-composer-node-modules/.pnpm/node_modules"
else
  export NODE_PATH="/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/bin/node_modules:/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/node_modules:/tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules:/tmp/better-composer-node-modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../../../../../../../tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/bin/knip-bun.js" "$@"
else
  exec bun  "$basedir/../../../../../../../tmp/better-composer-node-modules/.pnpm/knip@6.44.0/node_modules/knip/bin/knip-bun.js" "$@"
fi
